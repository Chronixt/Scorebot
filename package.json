{
  "name": "factoid-bureau-scorebot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "commands:register": "tsx scripts/register-commands.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply SCOREBOT_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply SCOREBOT_DB --remote"
  },
  "dependencies": {
    "discord-interactions": "^4.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260927.1",
    "@cloudflare/vitest-plugin": "^1.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.142.0"
  }
}
